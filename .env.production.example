# Use a project name distinct from development so container and volume names do
# not collide on a computer that hosts both environments.
COMPOSE_PROJECT_NAME=finance_helper_production

# PostgreSQL configuration. Replace both password placeholders with the same
# long, random value. If it contains URL-reserved characters, percent-encode
# them in DATABASE_URL or choose a URL-safe generated password.
POSTGRES_DB=finance_helper
POSTGRES_USER=finance_helper
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://finance_helper:REPLACE_WITH_THE_SAME_DATABASE_PASSWORD@db:5432/finance_helper

# Django configuration. Generate a unique secret for this installation.
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_DJANGO_SECRET
DJANGO_DEBUG=false
DJANGO_ALLOW_SIGNUP=true
ALLOWED_HOSTS=api,127.0.0.1,localhost

# Web configuration. NEXT_PUBLIC_APP_TIME_ZONE is baked into the web image, so
# rebuild that image after changing it.
NEXT_PUBLIC_APP_TIME_ZONE=America/New_York
WEB_PORT=3000
